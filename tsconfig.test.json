{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-dist",
    "noEmit": false,
    "verbatimModuleSyntax": false,
    "isolatedModules": false
  },
  "include": [
    "src/app/config/**/*.ts",
    "src/app/core/calculations.ts",
    "src/app/core/format.ts",
    "src/app/core/storage.ts",
    "src/app/types.ts",
    "tests/**/*.ts"
  ]
}
